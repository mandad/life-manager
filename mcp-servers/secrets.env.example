# LLM-Land MCP secrets / env  --  TEMPLATE (safe to commit; holds no real values)
#
# Copy this into WSL, fill in real values, lock it down, and keep it OUT of OneDrive/git:
#   mkdir -p ~/.config/llm-land-mcp
#   cp /mnt/c/Users/damia/OneDrive/Documents/LLM_Land/mcp-servers/secrets.env.example ~/.config/llm-land-mcp/secrets.env
#   chmod 600 ~/.config/llm-land-mcp/secrets.env
#
# mcp-sync.py sources this file before launching each server, so every server
# sees these vars. Values may reference $HOME (expanded by bash at source time).

# --- foursquare-checkins ---
FOURSQUARE_OAUTH_TOKEN=

# --- nws-forecast --- (not secret; just an identifying UA string for api.weather.gov)
NWS_USER_AGENT="llm-land (accounts@dmanda.com)"

# --- rescuetime ---
RESCUETIME_API_KEY=

# --- onenote --- (device-code public client; no secret. token file is written by `npm run auth`)
ONENOTE_CLIENT_ID=
ONENOTE_TOKEN_PATH="$HOME/.config/llm-land-mcp/onenote-token.json"

# --- whoop ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_PORT=8080
WHOOP_REDIRECT_URI="http://localhost:8080/callback"
# Points at your EXISTING token file by default so you don't have to re-auth.
# Move it under ~/.config/llm-land-mcp/ if you'd rather not keep tokens in OneDrive.
WHOOP_TOKENS_FILE="/mnt/c/Users/damia/OneDrive/Documents/LLM_Land/mcp-servers/whoop/tokens.json"

# --- google-tasks --- (READ-ONLY: tasks.readonly only; NO Gmail/Drive/Calendar access)
# Desktop-app OAuth client from Google Cloud Console. The secret is not load-bearing (PKCE is
# used) but Google issues one for Desktop clients; leave blank if yours has none.
# Token file is written by `npm run auth` and chmod 600. See google-tasks/SETUP.md.
GOOGLE_TASKS_CLIENT_ID=
GOOGLE_TASKS_CLIENT_SECRET=
GOOGLE_TASKS_TOKEN_PATH="$HOME/.config/llm-land-mcp/google-tasks-token.json"

# --- scripts (NOT MCP servers) ---
# Read by scripts/_secrets.py, which loads this file without overriding anything already
# exported. Consolidated here 2026-08-16 (automation #42) from ~/.bashrc and a token file that
# had been living inside OneDrive. Only these two scripts need a credential at all —
# ship-position / scs-weather / aurora-forecast hit public endpoints and need nothing.
SYNOPTIC_TOKEN=
TOMORROW_API_KEY=

# Last.fm read-only API key (no OAuth, no shared secret needed for reads).
# Get one at https://www.last.fm/api/account/create — LASTFM_USER is your Last.fm username.
LASTFM_API_KEY=
LASTFM_USER=
