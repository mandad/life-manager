{
  "name": "google-tasks-mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing READ-ONLY Google Tasks for a work Google account (tasks.readonly). No Gmail, no Drive, no Calendar.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-tasks-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rimraf dist",
    "auth": "node dist/auth.js",
    "check": "node dist/auth.js --check"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.7.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
